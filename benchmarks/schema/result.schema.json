{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attune-ai.dev/schemas/attune-interaction-benchmark-result-v0.json",
  "title": "Attune Interaction Benchmark Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "scenario_id",
    "scenario_family",
    "condition",
    "model",
    "clarification_round_trips",
    "human_turns",
    "task_success",
    "silent_assumptions",
    "accidental_approval",
    "scope_mismatch",
    "stale_approval_execution",
    "tokens_input",
    "tokens_output",
    "elapsed_ms",
    "notes"
  ],
  "properties": {
    "benchmark_version": {"type": "string", "pattern": "^0\\.[0-9]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_family": {
      "type": "string",
      "enum": [
        "ambiguous_requirements",
        "consequential_action",
        "agent_pushback",
        "conflicting_recommendations",
        "assumption_exposure",
        "multi_item_triage"
      ]
    },
    "condition": {
      "type": "string",
      "enum": ["free_form", "sequential_clarification", "typed_interaction", "host_native_structured"]
    },
    "model": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "null"]},
    "clarification_round_trips": {"type": "integer", "minimum": 0},
    "human_turns": {"type": "integer", "minimum": 0},
    "task_success": {"type": "boolean"},
    "silent_assumptions": {"type": "integer", "minimum": 0},
    "accidental_approval": {"type": "boolean"},
    "scope_mismatch": {"type": "boolean"},
    "stale_approval_execution": {"type": "boolean"},
    "authorization_reuse_outside_scope": {"type": "boolean"},
    "invalid_or_ambiguous_responses": {"type": "integer", "minimum": 0},
    "omitted_required_decisions": {"type": "integer", "minimum": 0},
    "post_execution_corrections": {"type": "integer", "minimum": 0},
    "decision_reversal": {"type": "boolean"},
    "tokens_input": {"type": "integer", "minimum": 0},
    "tokens_output": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "perceived_effort": {"type": ["number", "null"], "minimum": 0},
    "perceived_clarity": {"type": ["number", "null"], "minimum": 0},
    "decision_confidence": {"type": ["number", "null"], "minimum": 0},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
