{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attune-ai.dev/schemas/interaction-run-protocol-v0.json",
  "title": "Attune Interaction Benchmark run protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "protocol_id",
    "status",
    "created_on",
    "benchmark_version",
    "fixture",
    "scoring_policy",
    "conditions",
    "provider",
    "sampling",
    "repeats_per_scenario_condition",
    "execution_order",
    "exclusions",
    "missing_data",
    "falsification_rules",
    "real_external_actions",
    "checkpoint"
  ],
  "properties": {
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "status": {"enum": ["chair_required", "ratified", "retired"]},
    "created_on": {"type": "string", "format": "date"},
    "benchmark_version": {"type": "string", "pattern": "^0\\.[0-9]+$"},
    "fixture": {"$ref": "#/$defs/versioned_file"},
    "scoring_policy": {
      "allOf": [
        {"$ref": "#/$defs/versioned_file"},
        {
          "type": "object",
          "required": ["version"],
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        }
      ]
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "adapter_id", "adapter_version"],
        "properties": {
          "condition": {"enum": ["free_form", "sequential_clarification"]},
          "adapter_id": {"type": "string", "minLength": 1},
          "adapter_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_api_version", "model_id", "model_version"],
      "properties": {
        "provider_id": {"type": ["string", "null"], "minLength": 1},
        "provider_api_version": {"type": ["string", "null"], "minLength": 1},
        "model_id": {"type": ["string", "null"], "minLength": 1},
        "model_version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "temperature",
        "top_p",
        "seed",
        "max_output_tokens",
        "other_parameters",
        "unsupported_or_unavailable"
      ],
      "properties": {
        "mode": {"enum": [null, "deterministic", "stochastic", "provider_default"]},
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "other_parameters": {"type": "object"},
        "unsupported_or_unavailable": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "repeats_per_scenario_condition": {"type": "integer", "minimum": 3},
    "execution_order": {"enum": ["scenario_condition_repeat"]},
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_run", "post_run", "retain_incomplete"],
      "properties": {
        "pre_run": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "post_run": {"const": "none"},
        "retain_incomplete": {"const": true}
      }
    },
    "missing_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_value", "task_success_if_primary_missing", "aggregation"],
      "properties": {
        "metric_value": {"const": "null"},
        "task_success_if_primary_missing": {"const": "null"},
        "aggregation": {"type": "string", "minLength": 1}
      }
    },
    "falsification_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "consequence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+$"},
          "trigger": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1}
        }
      }
    },
    "real_external_actions": {"const": false},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ruling", "authorized_by", "authorized_at"],
      "properties": {
        "id": {"const": "B.1"},
        "ruling": {"enum": ["CHAIR_REQUIRED", "COLLECTION_AUTHORIZED", "COLLECTION_BLOCKED"]},
        "authorized_by": {"type": ["string", "null"], "minLength": 1},
        "authorized_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "versioned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string"},
        "scenario_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
