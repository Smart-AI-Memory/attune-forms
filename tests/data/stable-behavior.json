      "enum": [
       "impl",
       "test",
       "docs",
       "migration",
       "release-notes"
      ],
      "type": "string"
     },
     "minItems": 1,
     "title": "Which concerns apply?",
     "type": "array"
    },
    "estimated_days": {
     "maximum": 30,
     "minimum": 0,
     "title": "Estimated effort in days?",
     "type": "number"
    },
    "feature_name": {
     "description": "A short human-readable name.",
     "title": "What is the feature called?",
     "type": "string"
    },
    "finding_rulings.retry-loop": {
     "default": "fix now",
     "description": "high \u00b7 worker.py:88",
     "enum": [
      "fix now",
      "ticket",
      "dismiss"
     ],
     "title": "Rule each review finding. \u2014 Unbounded retry loop",
     "type": "string"
    },
    "finding_rulings.stale-doc": {
     "description": "low",
     "enum": [
      "fix now",
      "ticket",
      "dismiss"
     ],
     "title": "Rule each review finding. \u2014 Stale docstring",
     "type": "string"
    },
    "flag_flip_gate": {
     "description": "Will: Flag flips to 100% rollout (high) \u2014 reversible via the same flag; Announcement email sends (irreversible)",
     "enum": [
      "Approve",
      "Abort"
     ],
     "title": "Enable the feature flag for all users now?",
     "type": "string"
    },
    "inferred_scope.Tests run in CI on every push": {
     "enum": [
      "accept",
      "edit",
      "reject"
     ],
     "title": "I inferred these from context \u2014 rule each one. \u2014 Tests run in CI on every push",
     "type": "string"
    },
    "inferred_scope.Tests run in CI on every push.text": {
     "description": "Only read when the ruling is edit",
     "title": "Replacement text if editing \u2014 Tests run in CI on every push",
     "type": "string"
    },
    "inferred_scope.host": {
     "description": "plugin/.claude-plugin/marketplace.json \u00b7 the plugin manifest names it",
     "enum": [
      "accept",
      "edit",
      "reject"
     ],
     "title": "I inferred these from context \u2014 rule each one. \u2014 Claude Code is the only host",
     "type": "string"
    },
    "inferred_scope.host.text": {
     "description": "Only read when the ruling is edit",
     "title": "Replacement text if editing \u2014 Claude Code is the only host",
     "type": "string"
    },
    "inferred_scope.py-floor": {
     "default": "accept",
     "description": "pyproject.toml requires-python",
     "enum": [
      "accept",
      "edit",
      "reject"
     ],
     "title": "I inferred these from context \u2014 rule each one. \u2014 Python 3.10 is the floor",
     "type": "string"
    },
    "inferred_scope.py-floor.text": {
     "description": "Only read when the ruling is edit",
     "title": "Replacement text if editing \u2014 Python 3.10 is the floor",
     "type": "string"
    },
    "needs_migration": {
     "enum": [
      "Yes",
      "No"
     ],
     "title": "Does it require a data migration?",
     "type": "string"
    },
    "notes": {
     "maxLength": 500,
     "title": "Anything else to capture?",
     "type": "string"
    },
    "priority": {
     "enum": [
      "low",
      "medium",
      "high"
     ],
     "title": "How urgent is it?",
     "type": "string"
    },
    "rollout": {
     "enum": [
      "Ship behind a feature flag",
      "Ship to everyone at once",
      "Hold for the next release"
     ],
